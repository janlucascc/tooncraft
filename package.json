{
  "name": "tooncraft",
  "version": "0.1.0",
  "description": "Code-as-Webtoon engine: turn structured story JSON (written by an AI agent from a prompt) into vertical-scroll webtoons rendered with pure SVG — no generative images required.",
  "type": "module",
  "license": "MIT",
  "author": "janlucascc",
  "homepage": "https://github.com/janlucascc/tooncraft#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janlucascc/tooncraft.git"
  },
  "bugs": {
    "url": "https://github.com/janlucascc/tooncraft/issues"
  },
  "keywords": [
    "webtoon",
    "manhwa",
    "manga",
    "comic",
    "svg",
    "vertical-scroll",
    "ai-agent",
    "skill",
    "storyboard"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "tooncraft": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "scripts",
    "SKILL.md",
    "references",
    "examples"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:examples": "node scripts/validate-examples.mjs",
    "render:examples": "node scripts/render-examples.mjs"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "commander": "^15.1.0",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/opentype.js": "^1.3.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
